{
  "name": "np-stats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:data": "tsx scripts/build-dataset.ts && tsx scripts/build-dataset-grund.ts",
    "copy:csv": "mkdir -p public/data_np/grund && cp data_np/*.csv public/data_np/ && cp data_np/grund/*.csv public/data_np/grund/",
    "predev": "npm run build:data && npm run copy:csv",
    "prebuild": "npm run build:data && npm run copy:csv",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "next": "15.5.15",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
